    G --> H["dlsym(handle, name)"]
    H --> I{"dlsym 是否成功?"}
    I -- "是" --> J["使用 symbol_value\n按 relocation type 写目标地址"]
    I -- "否" --> K["dlerror + strstr\n检查非全局符号提示"]
    K -- "非全局" --> L["sub_2CE8 SysV hash fallback\nbucket/chain 查隐藏符号"]
